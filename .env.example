# --- Baza danych ---
# Lokalnie (Postgres z Homebrew):
DATABASE_URL=postgres://localhost:5432/tofilabs_kantor
# Neon (Vercel) — connection string "pooled" z panelu Neon:
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Logowanie do dashboardu ---
AUTH_USERNAME=admin
AUTH_PASSWORD=zmien-mnie
# min. 32 znaki, np.: openssl rand -hex 32
AUTH_SECRET=

# --- Harmonogram scrapingu (/api/cron) ---
# np.: openssl rand -hex 24
CRON_SECRET=
